rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Game state lives on the server (in memory + Redis), never in Firestore.
    // Locked so the old gameState/live doc (left by the retired no-server
    // backup) can't be read or written from a browser.
    match /gameState/{document} {
      allow read, write: if false;
    }

    // control/config.audienceFormUrl: the optional registration-screen form,
    // read by audience phones before they join the game. Edited from the
    // Firebase console only (the console bypasses these rules).
    match /control/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Voter registrations: each signed-in user can read/write ONLY their own doc.
    // (The server writes via the Admin SDK.)
    // No public read/delete — keeps attendee name + phone private.
    match /voters/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
